# Copy this file to ".env" and fill in your keys. NEVER commit the real .env file.

# Required. Free key: https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Optional. Better search results. Free key: https://tavily.com
# Without it, TripGenie searches with DuckDuckGo only.
TAVILY_API_KEY=your_tavily_key_here

# Optional settings
# "local"   = trips are saved in data/trip_history.json (default, for your own computer)
# "session" = trips are kept only for the visit (use this on a public website)
# STORAGE_MODE=local

# How many plans + changes one visitor can ask for in one session (default 10)
# MAX_RUNS_PER_SESSION=10

# LangSmith tracing is OFF by default. Turn it on only if you have a LangSmith key.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key_here
